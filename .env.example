# ─── Backend (Laravel) ──────────────────────────────────────────────
# Proxied through /api/v1 by the rewrites in next.config.ts
API_URL=
NEXT_PUBLIC_API_URL=

# Canonical site origin — metadata, gateway returns, CSRF origin header
NEXT_PUBLIC_SITE_URL=

# ─── Feature flags ──────────────────────────────────────────────────
# Server-backed guest checkout (flag-gated feature)
NEXT_PUBLIC_GUEST_CHECKOUT=

# Verbose XHR logging
NEXT_PUBLIC_XHR_LOGS=false

# ─── Third-party services ───────────────────────────────────────────
# Google Maps — checkout map picker
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Laravel Pusher — realtime notifications
NEXT_PUBLIC_PUSHER_APP_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# Google Tag Manager container (GA4 ecommerce). Leave empty to disable
# analytics entirely — no GTM script is rendered without it.
# Project-specific: each client project uses its own GTM container.
NEXT_PUBLIC_GTM_ID=
